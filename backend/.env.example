# =============================================================================
# getSocial Backend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# SECURITY WARNING: Change this in production!
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production-min-50-chars

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
# Development: localhost,127.0.0.1,[::1]
# Production: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Option 1: Use DATABASE_URL (single string, preferred for production)
# Uncomment and set this for Heroku, Render, Railway, etc.
# DATABASE_URL=postgres://username:password@host:5432/database_name
# DB_SSL_REQUIRE=True

# Option 2: Individual database settings (good for development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# For PostgreSQL development, use:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=getsocial_dev
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSL_REQUIRE=False

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Allowed origins for CORS (comma-separated list)
# Must match your frontend URL exactly
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For production:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------

# Celery broker URL (RabbitMQ, Redis, etc.)
# Development (local RabbitMQ):
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Production (hosted RabbitMQ):
# CELERY_BROKER_URL=amqps://username:password@your-rabbitmq-host:5672//

# Or with Redis:
# CELERY_BROKER_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Redis Configuration (for Channels)
# -----------------------------------------------------------------------------

# Redis host for Django Channels
# Development:
REDIS_HOST=localhost
REDIS_PORT=6379

# Production:
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------

# Email backend for password resets, notifications, etc.
# Development (console output):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production (SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# AWS S3 Configuration (Optional - for media files in production)
# -----------------------------------------------------------------------------

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# -----------------------------------------------------------------------------
# Logging & Monitoring (Optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security Headers (Production)
# -----------------------------------------------------------------------------

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------

# 1. Never commit .env files to Git!
#    Add to .gitignore: echo ".env" >> .gitignore
#
# 2. Use strong passwords (16+ characters, mix of letters/numbers/symbols)
#    Generate with: openssl rand -base64 32
#
# 3. For production, generate a new SECRET_KEY:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# 4. Test your configuration:
#    python manage.py check
#    python manage.py check --deploy  (for production)
#
# 5. Database URL format examples:
#    PostgreSQL: postgres://user:password@host:5432/dbname
#    MySQL: mysql://user:password@host:3306/dbname
#    SQLite: sqlite:///path/to/db.sqlite3
